{
  "$description": "Developed by Me tokens, DTCG format. Tiers: primitive -> semantic (per theme) -> component.",
  "primitive": {
    "color": {
      "ink":    { "0": {"$type":"color","$value":"#ffffff"}, "50": {"$type":"color","$value":"#f6f5f1"}, "100": {"$type":"color","$value":"#ecebe5"}, "200": {"$type":"color","$value":"#d9d7ce"}, "400": {"$type":"color","$value":"#8f8c80"}, "600": {"$type":"color","$value":"#55534b"}, "800": {"$type":"color","$value":"#26251f"}, "900": {"$type":"color","$value":"#171612"}, "950": {"$type":"color","$value":"#0e0d0b"}, "1000": {"$type":"color","$value":"#000000"} },
      "brand":  { "default": {"$type":"color","$value":"#3b4bdb"} },
      "pop":    { "lime": {"$type":"color","$value":"#c9f24a"}, "coral": {"$type":"color","$value":"#ff7a59"}, "sky": {"$type":"color","$value":"#6fc3ff"}, "sun": {"$type":"color","$value":"#ffd23f"} },
      "status": { "danger-600": {"$type":"color","$value":"#b42318"}, "danger-300": {"$type":"color","$value":"#ff8a80"}, "ok-700": {"$type":"color","$value":"#16683a"}, "ok-300": {"$type":"color","$value":"#7be0a0"}, "warn-700": {"$type":"color","$value":"#8a5a00"}, "warn-300": {"$type":"color","$value":"#ffc861"} }
    },
    "family": {
      "display": {"$type":"fontFamily","$value":"var(--next-display), 'Arial Narrow', system-ui, sans-serif"},
      "body":    {"$type":"fontFamily","$value":"var(--next-body), system-ui, sans-serif"},
      "mono":    {"$type":"fontFamily","$value":"var(--next-mono), ui-monospace, monospace"}
    },
    "size": {
      "1": {"$type":"dimension","$value":"0.75rem"}, "2": {"$type":"dimension","$value":"0.875rem"}, "3": {"$type":"dimension","$value":"1rem"},
      "4": {"$type":"dimension","$value":"1.125rem"}, "5": {"$type":"dimension","$value":"1.5rem"}, "6": {"$type":"dimension","$value":"2rem"},
      "display": {"$type":"dimension","$value":"clamp(3rem, 2.2rem + 2.2vw, 4rem)"}
    },
    "radius": { "s": {"$type":"dimension","$value":"6px"}, "m": {"$type":"dimension","$value":"12px"}, "l": {"$type":"dimension","$value":"20px"}, "pill": {"$type":"dimension","$value":"999px"} },
    "duration": { "fast": {"$type":"duration","$value":"140ms"}, "base": {"$type":"duration","$value":"260ms"}, "slow": {"$type":"duration","$value":"520ms"} },
    "ease": { "out": {"$type":"cubicBezier","$value":"cubic-bezier(.2,.8,.2,1)"}, "press": {"$type":"cubicBezier","$value":"cubic-bezier(.3,1.6,.5,1)"} }
  },
  "semantic": {
    "light": {
      "bg":          {"$type":"color","$value":"{primitive.color.ink.50}"},
      "surface":     {"$type":"color","$value":"{primitive.color.ink.0}"},
      "surface-2":   {"$type":"color","$value":"{primitive.color.ink.100}"},
      "border":      {"$type":"color","$value":"{primitive.color.ink.200}"},
      "border-strong":{"$type":"color","$value":"{primitive.color.ink.600}"},
      "text":        {"$type":"color","$value":"{primitive.color.ink.900}"},
      "text-muted":  {"$type":"color","$value":"{primitive.color.ink.600}"},
      "action":      {"$type":"color","$value":"var(--brand-light, {primitive.color.brand.default})"},
      "on-action":   {"$type":"color","$value":"{primitive.color.ink.0}"},
      "focus":       {"$type":"color","$value":"var(--brand-light, {primitive.color.brand.default})"},
      "highlight":   {"$type":"color","$value":"{primitive.color.pop.sun}"},
      "danger":      {"$type":"color","$value":"{primitive.color.status.danger-600}"},
      "ok":          {"$type":"color","$value":"{primitive.color.status.ok-700}"},
      "warn":        {"$type":"color","$value":"{primitive.color.status.warn-700}"},
      "stamp":       {"$type":"color","$value":"var(--brand-light, {primitive.color.brand.default})"}
    },
    "dark": {
      "bg":          {"$type":"color","$value":"{primitive.color.ink.950}"},
      "surface":     {"$type":"color","$value":"{primitive.color.ink.900}"},
      "surface-2":   {"$type":"color","$value":"{primitive.color.ink.800}"},
      "border":      {"$type":"color","$value":"{primitive.color.ink.800}"},
      "border-strong":{"$type":"color","$value":"{primitive.color.ink.400}"},
      "text":        {"$type":"color","$value":"{primitive.color.ink.50}"},
      "text-muted":  {"$type":"color","$value":"{primitive.color.ink.400}"},
      "action":      {"$type":"color","$value":"var(--brand-dark, #9aa5ff)"},
      "on-action":   {"$type":"color","$value":"{primitive.color.ink.950}"},
      "focus":       {"$type":"color","$value":"var(--brand-dark, #9aa5ff)"},
      "highlight":   {"$type":"color","$value":"{primitive.color.pop.lime}"},
      "danger":      {"$type":"color","$value":"{primitive.color.status.danger-300}"},
      "ok":          {"$type":"color","$value":"{primitive.color.status.ok-300}"},
      "warn":        {"$type":"color","$value":"{primitive.color.status.warn-300}"},
      "stamp":       {"$type":"color","$value":"var(--brand-dark, #9aa5ff)"}
    },
    "hc": {
      "bg":          {"$type":"color","$value":"{primitive.color.ink.1000}"},
      "surface":     {"$type":"color","$value":"{primitive.color.ink.1000}"},
      "surface-2":   {"$type":"color","$value":"{primitive.color.ink.900}"},
      "border":      {"$type":"color","$value":"{primitive.color.ink.0}"},
      "border-strong":{"$type":"color","$value":"{primitive.color.ink.0}"},
      "text":        {"$type":"color","$value":"{primitive.color.ink.0}"},
      "text-muted":  {"$type":"color","$value":"{primitive.color.ink.100}"},
      "action":      {"$type":"color","$value":"var(--brand-hc, #ffd23f)"},
      "on-action":   {"$type":"color","$value":"{primitive.color.ink.1000}"},
      "focus":       {"$type":"color","$value":"var(--brand-hc, #ffd23f)"},
      "highlight":   {"$type":"color","$value":"{primitive.color.pop.sky}"},
      "danger":      {"$type":"color","$value":"{primitive.color.status.danger-300}"},
      "ok":          {"$type":"color","$value":"{primitive.color.status.ok-300}"},
      "warn":        {"$type":"color","$value":"{primitive.color.status.warn-300}"},
      "stamp":       {"$type":"color","$value":"var(--brand-hc, #ffd23f)"}
    }
  },
  "density": {
    "comfortable": { "space-1": {"$type":"dimension","$value":"4px"}, "space-2": {"$type":"dimension","$value":"8px"}, "space-3": {"$type":"dimension","$value":"12px"}, "space-4": {"$type":"dimension","$value":"16px"}, "space-5": {"$type":"dimension","$value":"24px"}, "space-6": {"$type":"dimension","$value":"32px"}, "space-7": {"$type":"dimension","$value":"48px"}, "control-h": {"$type":"dimension","$value":"44px"} },
    "compact":     { "space-1": {"$type":"dimension","$value":"2px"}, "space-2": {"$type":"dimension","$value":"6px"}, "space-3": {"$type":"dimension","$value":"8px"}, "space-4": {"$type":"dimension","$value":"12px"}, "space-5": {"$type":"dimension","$value":"16px"}, "space-6": {"$type":"dimension","$value":"24px"}, "space-7": {"$type":"dimension","$value":"32px"}, "control-h": {"$type":"dimension","$value":"36px"} }
  },
  "component": {
    "button-bg":       {"$type":"color","$value":"{semantic.action}"},
    "button-fg":       {"$type":"color","$value":"{semantic.on-action}"},
    "button-radius":   {"$type":"dimension","$value":"{primitive.radius.pill}"},
    "card-bg":         {"$type":"color","$value":"{semantic.surface}"},
    "card-radius":     {"$type":"dimension","$value":"{primitive.radius.l}"}
  }
}
